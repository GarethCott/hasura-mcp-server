# Hasura MCP Server Configuration

# Hasura GraphQL endpoint
HASURA_ENDPOINT=https://your-hasura-endpoint.hasura.app

# Hasura admin secret (optional but recommended)
HASURA_ADMIN_SECRET=your-admin-secret-here

# Path to your Hasura project directory
HASURA_PROJECT_PATH=/path/to/your/hasura/project

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO 