# Hasura MCP Server Configuration

# Hasura GraphQL endpoint
HASURA_ENDPOINT=http://localhost:8080

# Hasura admin secret (optional but recommended)
HASURA_ADMIN_SECRET=your-admin-secret-here

# Path to your Hasura project directory
HASURA_PROJECT_PATH=./hasura-project

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_CONNECTION_STRING=postgresql://username:password@localhost:5432/database
POSTGRES_POOL_SIZE=10
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000 